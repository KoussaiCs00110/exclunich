# Copy to .env.local. This file contains no usable credentials.
# Generate a stable secret with: openssl rand -hex 32
# Keep a secure backup. Changing it invalidates access tokens AND recovery codes.
TOKEN_PEPPER=

# Exact browser origin. HTTPS is required in production.
APP_URL=http://localhost:3000

# Optional synthetic frontend demo. Works only in development on a loopback host.
# Login token: ABS-LOCAL-DEMO. Never enables authentication bypass in production.
LOCAL_DEMO_MODE=false

# Recommended production storage: Supabase PostgreSQL over its server-only RPC.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternative for projects using the legacy JWT service_role key:
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct PostgreSQL adapter. When set, takes precedence over Supabase HTTP.
# Use a restricted app role with EXECUTE on public.absentia_api only at runtime.
DATABASE_URL=

# "none" uses a conservative shared rate-limit bucket (safe without trusted IPs).
# "vercel" trusts x-vercel-forwarded-for ONLY when the Vercel runtime provides VERCEL=1.
# "cloudflare" trusts cf-connecting-ip: use ONLY when the origin is restricted to Cloudflare.
TRUST_PROXY=none

# Optional network-bucket limits per 15 minutes (credential limit remains 8).
# Defaults: 240 auth attempts and 60 registrations. Tune for shared campus NAT.
AUTH_NETWORK_LIMIT=240
REGISTRATION_NETWORK_LIMIT=60
